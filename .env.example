# OpenAI-compatible endpoint credentials
LLM_API_KEY=

# Optional comma-separated pools for concurrent experiments.
# The frozen experiment runner uses LGAGENT_REASONING_API_KEYS and gives each
# in-flight sample exclusive use of one key. When omitted it uses LLM_API_KEY.
LGAGENT_REASONING_API_KEYS=
# Legacy role-separated evaluators can use a distinct Lawyer B key pool.
LGAGENT_EVAL_API_KEYS=

# Optional LegalMCQ role credentials. Each role falls back to LLM_API_KEY.
LGAGENT_CONTROLLER_API_KEY=
LGAGENT_SOLVER_API_KEY=
LGAGENT_SOLVER_FALLBACK_API_KEY=
LGAGENT_LEGAL_VERIFIER_API_KEY=

# Optional retrieval providers
RETRIEVER_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
ZHIPUAI_API_KEY=
